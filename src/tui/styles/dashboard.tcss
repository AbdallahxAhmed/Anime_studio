/* Anime Studio Dashboard — Premium Dark Theme */

Screen {
    background: $surface;
    color: $text;
}

/* ── Main Layout ── */

#main-container {
    width: 100%;
    height: 100%;
    padding: 1 2;
}

/* ── Header ── */

#header-panel {
    width: 100%;
    height: auto;
    background: $surface;
    padding: 1 2;
    margin-bottom: 1;
}

#header-title {
    color: $text;
    text-style: bold;
    width: 100%;
    content-align: center middle;
}

/* ── Input Area ── */

#input-panel {
    width: 100%;
    height: auto;
    background: $panel;
    padding: 1 2;
    margin-bottom: 1;
    border: round $primary;
}

#library-path {
    width: 100%;
    height: auto;
}

#library-path:focus {
    border: round $primary;
}

#controls-panel {
    width: 100%;
    height: auto;
    layout: horizontal;
    align: left middle;
    margin-top: 1;
}

#dry-run {
    width: auto;
    height: auto;
    margin-right: 4;
}

#run-pipeline {
    width: auto;
    height: auto;
}

/* ── Execution Container ── */

#execution-container {
    width: 100%;
    height: 1fr;
    layout: vertical;
}

/* ── Dry-Run Banner ── */

#dry-run-banner {
    width: 100%;
    height: auto;
    background: $warning;
    color: $text;
    text-style: bold;
    padding: 0 2;
    margin-bottom: 1;
    content-align: center middle;
    display: none;
}

/* ── Activity Feed ── */

#activity-feed-panel {
    width: 100%;
    height: 1fr;
    background: $surface;
    border: round $primary-lighten-2;
    margin-bottom: 1;
    padding: 1;
    display: none;
}

#activity-feed-log {
    width: 100%;
    height: 100%;
    background: transparent;
}

/* ── Progress Panel ── */

#progress-panel {
    width: 100%;
    height: auto;
    background: $panel;
    border: round $primary;
    padding: 1 2;
    margin-bottom: 1;
    display: none;
}

#progress-stage {
    width: 100%;
    height: auto;
    text-style: bold;
    color: $text;
}

#progress-bar {
    width: 100%;
    height: auto;
    margin: 1 0;
}

#progress-detail {
    width: 100%;
    height: auto;
    color: $text-muted;
}

/* ── Results Panel ── */

#results-panel {
    width: 100%;
    height: 1fr;
    background: $panel;
    border: round $success;
    padding: 1 2;
    display: none;
}

#results-title {
    width: 100%;
    height: auto;
    text-style: bold;
    color: $success;
    content-align: center middle;
    margin-bottom: 1;
}

#results-table {
    width: 100%;
    height: 1fr;
}

#results-summary-info {
    width: 100%;
    height: auto;
    margin: 1 0;
}

#results-path-label {
    width: 100%;
    height: auto;
    color: $primary;
    text-style: italic;
    margin-bottom: 1;
}

#run-again {
    width: auto;
    height: auto;
}

/* ── Error Modal ── */

ErrorModal {
    align: center middle;
}

#error-modal-container {
    width: 60%;
    max-height: 80%;
    background: $panel;
    border: round $error;
    padding: 2 3;
}

#error-title {
    color: $error;
    text-style: bold;
    margin-bottom: 1;
}

#error-message {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

#error-suggestion {
    width: 100%;
    height: auto;
    color: $warning;
    margin-bottom: 1;
}

#dismiss-button {
    width: auto;
    height: auto;
}
